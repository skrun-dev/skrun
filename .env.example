# ============================================================================
# Skrun — environment variables (copy to .env and fill in)
# ============================================================================

# ----- LLM Provider API Keys -----
# Set at least one. The runtime auto-detects which providers are usable
# from these env vars; the model declared in agent.yaml decides which
# is actually called for a given run.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=your-google-api-key-here
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...

# ----- Cloud / Production (required when NODE_ENV=production) -----

# Webhook HMAC signing — REQUIRED to deliver async-mode webhooks
# (POST /run with `webhook_url` in the body). The runtime refuses to
# send webhooks if this is unset (no insecure default).
# Generate a long random string, e.g.:
#   openssl rand -hex 32
# and keep it secret. Downstream receivers verify the X-Skrun-Signature
# header against this key.
WEBHOOK_SIGNING_KEY=

# Allow webhook delivery to private / loopback hosts (e.g. http://localhost:NNNN).
# Fail-closed: OFF unless set to exactly "true". For LOCAL webhook testing only —
# never enable on a reachable deployment, it re-opens the SSRF surface toward
# cloud-metadata / internal services. Default: private / non-HTTPS targets refused.
SKRUN_ALLOW_LOCAL_WEBHOOKS=

# Allow an agent-declared `model.base_url` to point at a private / loopback
# address — the documented Ollama, vLLM and LocalAI case. Fail-closed: OFF
# unless set to exactly "true". Leave off on a shared instance: an endpoint
# chosen by an agent author is otherwise a request-forgery primitive against
# your internal network.
SKRUN_ALLOW_LOCAL_MODEL_HOSTS=

# Allow the SERVER's own LLM key to be sent to an endpoint an agent declares
# in `model.base_url`. Fail-closed: OFF unless set to exactly "true". Off by
# default because any agent author could otherwise redirect your key to a host
# they control. Enable only where every agent on this instance is yours —
# callers can always supply their own key instead (X-LLM-API-Key).
SKRUN_ALLOW_SERVER_KEY_CUSTOM_BASE_URL=

# CORS allowed origin(s) — REQUIRED when NODE_ENV=production. The API
# fails fast at startup if unset in prod.
# Comma-separated list, e.g.
#   https://app.example.com
#   https://app.example.com,https://staging.example.com
# Defaults to '*' in dev so local `pnpm dev:registry` + dashboard stay
# frictionless.
CORS_ORIGIN=

# ----- Storage / Database (optional — defaults to local SQLite) -----

# Postgres backing — when set, the registry uses PostgresDb instead of
# the default SQLite + local-FS storage. Leave unset for self-host
# single-user mode (skrun.db + .skrun/bundles/).
#
# DATABASE_URL is a standard `postgres://user:pass@host:port/db`
# connection string. Works with any Postgres ≥ 14 host:
#   - Supabase: use the SESSION POOLER on port 5432. "Connect" button
#     → "ORMs" or "Connection string" → "Session pooler" → URI.
#     Session mode preserves session state (advisory locks, prepared
#     statements) — required by our migrations-runner's pg_advisory_lock
#     concurrent-boot safety. Direct connection (db.<ref>.supabase.co)
#     is IPv6-only ($4/mo Supabase IPv4 add-on as safety net);
#     Transaction Pooler (6543) breaks advisory locks.
#   - Fly Postgres: copy from `flyctl postgres connect` output.
#   - RDS / Neon / Render / docker-compose: standard URI.
#
# Migrations apply automatically on api-server boot (server.ts +
# dev.ts Postgres branch) via the migrations-runner with
# `pg_advisory_lock` concurrent-safety.
#
# DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgres://skrun:<your-password>@localhost:5432/skrun
#
# ⚠️ POSTGRES_PASSWORD is MANDATORY for the full `infra/docker-compose.yml`
# stack — it builds the compose DATABASE_URL and Postgres's own superuser
# password from it. It used to fall back to `skrun-dev-only`, so an empty .env
# booted the database on a password published in this repository. The stack now
# refuses to start on an empty password rather than pick one for you.
#   openssl rand -hex 16
# The minimal self-host overlay (docker-compose.minimal.yml) runs on SQLite and
# does not need it.
# POSTGRES_PASSWORD=

# ----- OAuth (optional self-host, required for cloud / multi-user) -----

# GitHub OAuth app credentials — when BOTH are set, the registry runs
# in OAuth mode and rejects the `dev-token` shortcut. See docs/self-hosting.md.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Signup allowlist (optional, default = open signup). Restricts who may sign in
# via GitHub OAuth — for a private instance or a closed beta. Comma-separated;
# each entry is a username (case-insensitive) or id:<NNN> (the immutable GitHub
# id, survives a rename). When set, ONLY listed accounts may sign in (every
# login, web + `skrun login`); anyone else gets a "not authorized" page (no
# account created). Unset/empty = open. Include yourself — on an OAuth instance
# there is no dev-token escape, so a self-lockout is fixed only via this var.
# SKRUN_ALLOWED_GITHUB_USERS=alice,bob,id:90123

# CLI device-login (RFC 8628) code TTL in seconds (default 600). `skrun login`
# issues a short-lived device/user code pair the user confirms in the browser;
# a shorter TTL means a smaller window for device-code phishing. Optional.
# SKRUN_DEVICE_CODE_TTL_S=600

# Dev-token admin shortcut (fail-secure, default OFF). When SKRUN_DEV_AUTH is
# enabled (1/true/on/yes) AND OAuth is not configured, a `Bearer dev-token`
# request is treated as admin (namespace 'dev'). This grants admin to ANYONE
# who can reach the server — use it ONLY on localhost / a trusted private
# network, never a public host. `pnpm dev:registry` enables it automatically;
# the api-server REFUSES TO BOOT if it is enabled in production without OAuth.
# SKRUN_DEV_AUTH=1

# Verification policy (default 'admin'). Chooses who may attest an agent version
# and whether runs are gated on verification:
#   admin    (default) only instance admins verify; an unverified version can't
#            run (403 AGENT_NOT_VERIFIED) — the legacy behavior, so leaving this
#            unset changes nothing
#   owner    the agent owner may self-attest their own agents, and a private
#            agent runs without the gate (multi-tenant hosting — one operator
#            can't vet everyone's agents)
#   disabled no verification gate at all; the flag is inert metadata
# Read once at boot, so a change requires a restart. An invalid value fails the
# boot fast (the server refuses to start).
# SKRUN_VERIFICATION_POLICY=admin

# Secrets encryption key — REQUIRED only to attach a creator LLM key to an agent
# (the per-agent key your callers can run on without supplying their own). Skrun
# encrypts creator keys at rest with AES-256-GCM under this 32-byte master key;
# when unset, attaching a creator key is refused (runs still resolve caller /
# server keys normally). Generate one and keep it secret + backed up:
#   openssl rand -base64 32
# A malformed value fails the boot fast.
# ⚠️  Rotating this key WITHOUT re-encrypting the agent_llm_keys rows makes every
#     attached creator key undecryptable — agents relying on them then fail at run
#     time. Treat it like a database credential.
# SKRUN_SECRETS_ENCRYPTION_KEY=

# Lifetime of a dashboard sign-in session, in seconds. Default 86400 (24 h).
# Applies to the browser session cookie minted after the OAuth callback — API
# keys are unaffected. A non-numeric or non-positive value falls back to the
# default rather than failing the boot.
# SESSION_TTL_S=86400

# ----- Bundle / Runtime advisory limits (optional, defaults are sane) -----

# Fast-failover timeout for the primary LLM call, in ms. Default 45000. When an
# agent declares a fallback model and the primary provider hangs longer than
# this, the runtime stops waiting and switches to the fallback instead of
# blocking on the provider SDK's own timeout (~180 s). Raise it if you run very
# long single turns (large context / heavy reasoning) and see spurious
# failovers; lower it to fail over faster. No effect on agents without a
# declared fallback.
# SKRUN_PRIMARY_FAILOVER_MS=45000

# pino log level: debug | info | warn | error. Default info.
# LOG_LEVEL=info

# Bundle-extraction cache: how long an extracted bundle stays warm (seconds) and
# how many extractions are kept. Defaults 600 / 50.
# BUNDLE_CACHE_TTL=600
# BUNDLE_CACHE_MAX=50

# Script-deps cache root (per-host). Default ~/.skrun/deps. Agents declaring a
# package.json / requirements.txt / pyproject.toml resolve their deps on first
# call and share a content-addressed cache entry per identical manifest.
# SKRUN_DEPS_DIR=

# Dashboard agent import — points at the demo agents directory.
# Path is resolved relative to the registry's working directory.
# `pnpm dev:registry` runs from `packages/api/` so the path climbs two
# levels back to the repo root. Use `./agents` if you start the
# registry from the repo root directly.
SKRUN_AGENTS_DIR=../../agents

# ----- Operator dashboard (optional) -----

# The bare-metal install and the published image both serve the operator
# dashboard at /dashboard by default. Set to off/false/0 for a headless,
# API-only server.
SKRUN_DASHBOARD=on

# Path to the built dashboard SPA. Defaults to ../web/dist (bare-metal, cwd =
# packages/api) or /opt/skrun-web/dist in the published image. Override only to
# serve a custom dashboard build.
# SKRUN_DASHBOARD_DIR=

# Multimodal inputs — uploaded input files via POST /api/files
# INPUT_FILES_MAX_SIZE_MB=25         # Max upload size per file (default 25 MB)
# INPUT_FILES_RETENTION_S=86400      # How long uploaded inputs persist (default 24 h)
# INPUT_FILES_MAX_INLINE_MB=4        # Max base64 inline size on POST /run (default 4 MB)

# Bundle decompression cap — refuses .agent bundles
# that decompress beyond this size (gzip-bomb defense). Default 50 MB
# matches the current published bundle limit; raise it only if your
# legitimate agents exceed that.
# BUNDLE_MAX_DECOMPRESSED_MB=50

# MCP server connect timeout (ms). Each MCP server's connect() call (stdio
# spawn / SSE handshake / streamable-HTTP handshake) is bounded by this
# timeout, plumbed to the MCP SDK via client.connect(transport, { timeout }).
# On expiry the runtime logs `event=mcp_connect_timeout`, tears down the
# half-open transport, and the agent run FAILS with 502 MCP_CONNECT_FAILED.
# Default 120000 (2 min) accommodates stdio cold-starts via `npx -y @some/mcp`
# (@playwright/mcp measured at ~70s on warm chromium cache). Bump to 180000+
# if your runner downloads chromium / large MCP binaries from cold.
# MCP_CONNECT_TIMEOUT_MS=120000

# ============================================================================
# Cloud runtime (Fly.io machines + R2 storage)
# ============================================================================
# Set SKRUN_RUNTIME=flyio to run each `POST /run` inside a dedicated Fly.io
# machine spawned from the multi-runtime image. The harness (this API
# server) holds all credentials; the sandbox machine has zero credentials
# (network egress restricted via iptables to environment.networking.allowed_hosts).
# Default `local` keeps every run in-process — what self-host operators want.
# SKRUN_RUNTIME=local

# --- Fly.io Machines API (REQUIRED when SKRUN_RUNTIME=flyio) ---
# Generate a deploy token on the target app:
#   fly tokens create deploy -a <your-skrun-app>
# The token grants machine create/start/stop/destroy + reading machine
# metadata. Scope it to the dedicated app, not your personal account.
# FLY_API_TOKEN=
# SKRUN_RUNNERS_APP=
# NOTE — variable was renamed from FLY_APP_NAME on 2026-05-25. Fly auto-
# injects FLY_APP_NAME into every running machine's env as the current
# app's name, which silently overrode user-supplied secrets when the
# api-server tried to use that variable to identify the SANDBOX runners
# app (a different app). SKRUN_RUNNERS_APP is skrun-namespaced and
# collision-free.

# FLY_APP_NAME — legacy fallback, kept only for setups predating the rename.
# `skrun admin cleanup-machines` resolves its app as --app > SKRUN_RUNNERS_APP >
# FLY_APP_NAME, so you normally set nothing here. ⚠️ Inside a Fly machine Fly sets
# FLY_APP_NAME to that machine's OWN app, so a reaper falling back to it sweeps
# the wrong app and reports `scanned=0 cleaned=0`; the command warns when it does
# and names the swept app in its PASS line. See docs/cli.md → skrun admin.
# FLY_APP_NAME=

# Optional: only needed for the on-demand Fly smoke (`pnpm fly:smoke`).
# Distinct from SKRUN_RUNNERS_APP so the smoke doesn't accidentally hit the
# production sandbox app. Typically set to the same value as SKRUN_RUNNERS_APP
# in solo dev.
# FLY_TEST_APP_NAME=

# Image for the on-demand Fly smoke (`pnpm fly:smoke`) + the cold-start
# benchmark. Defaults to the always-resolvable `:edge` tag (published on every
# image build, never pruned), so you normally don't set this. Override only to
# pin a specific build, e.g. :vX.Y.Z after a stable release.
# FLY_TEST_IMAGE=ghcr.io/skrun-dev/skrun-runtime:edge

# Deployed cloud api-server URL + auth token for the on-demand cloud-E2E smoke
# (`pnpm cloud:e2e:smoke`). Point at the deployed test app. The token must be a
# durable `sk_live_*` API key: cloud / OAuth deployments reject the dev-token
# shortcut. Mint one by running `skrun login` against the deployed URL (the
# OAuth callback saves an sk_live_ key to ~/.skrun/config.json). A bare
# dev-token only works against a deployment that has OAuth disabled.
# SKRUN_CLOUD_API_URL=https://skrun-cloud-api-test.fly.dev
# SKRUN_CLOUD_API_TOKEN=sk_live_...

# Runner image the api-server spawns per run (pushed to GHCR by
# .github/workflows/runtime-image.yml). REQUIRED when SKRUN_RUNTIME=flyio — the
# server fails fast at startup if unset (no silent fallback). Tag policy:
#   :edge        latest build, always resolvable (dev / pre-release)
#   :latest      latest stable release
#   :vX.Y.Z      pinned stable (reproducible — recommended for production)
# ⚠️ Here the value is a FULL image reference. `infra/docker-compose.yml` reads a
# variable of the SAME NAME as the tag alone (it interpolates it after the colon),
# so uncommenting the line below in a .env that stack reads makes its image
# reference malformed and `docker compose up` fails. That stack runs
# SKRUN_RUNTIME=local, where this variable is never read at all.
# RUNTIME_IMAGE_TAG=ghcr.io/skrun-dev/skrun-runtime:edge

# Pre-warm pool: how many sandbox machines to keep built and paused so a run does
# not wait for one to be created. Default 0 = off, every run builds its own
# machine (unchanged behaviour). A pooled machine is blank until a run claims it,
# serves exactly one run, and is destroyed afterwards like any other. When the
# pool is empty a run simply takes the slower path — never an error. Watch it via
# GET /api/admin/pool. See docs/self-hosting.md → Pre-warm pool.
# SKRUN_RUNNER_POOL_SIZE=0

# --- Rate limiting (optional) ---
# The api-server rate-limits `push` (10/min) and `run` (60/min) per client IP.
# Single-instance self-host uses an in-memory limiter — nothing to set. For a
# MULTI-INSTANCE deployment, point it at Upstash Redis so the limit is shared
# across instances (otherwise it is counted per-process and can be bypassed):
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# Set when the api-server is behind a reverse proxy / load balancer, so the
# client IP is taken from X-Forwarded-For. Leave unset on a directly-exposed
# deployment — the header is then ignored (it would otherwise be spoofable).
# SKRUN_TRUST_PROXY=1

# --- S3-compatible object storage (REQUIRED when SKRUN_RUNTIME=flyio) ---
# Cloudflare R2 OR MinIO (self-host). Same code path; `S3_ENDPOINT` toggles:
#   - cloud (R2):      set S3_ACCOUNT_ID (or leave S3_ENDPOINT unset)
#   - self-host MinIO: set S3_ENDPOINT to your MinIO URL
# Bundle archives + run outputs live in S3_BUCKET under `runs/{runId}/outputs/`.
# Presigned GET URLs are emitted in `run_complete` events.
#
# ⚠️ MANDATORY for the full `infra/docker-compose.yml` stack. They used to have
# `:-minioadmin` fallbacks, so `docker compose up` with an empty .env booted
# MinIO on credentials anyone can guess. The stack now REFUSES to start rather
# than pick a default for you. MinIO would otherwise boot on minioadmin, so a
# preflight container stops the whole stack when either is empty.
#   openssl rand -hex 16
# The minimal self-host overlay (docker-compose.minimal.yml) runs on local disk
# and needs neither.
# S3_ACCOUNT_ID=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
