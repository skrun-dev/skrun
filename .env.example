# ============================================================================
# Skrun — environment variables. Copy this file, then fill in the copy:
#   .env        at the repository root, for the bare-metal install;
#   infra/.env  for the Docker Compose stack (infra/docker-compose.yml), which
#               hands the whole file to its api service. What that stack
#               decides itself is fixed in its compose file and wins over
#               infra/.env — see docs/self-hosting-docker.md.
# ============================================================================

# ----- LLM Provider API Keys -----
# Set at least one. The runtime auto-detects which providers are usable
# from these env vars; the model declared in agent.yaml decides which
# is actually called for a given run.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...

# ----- Cloud / Production (required when NODE_ENV=production) -----

# Webhook HMAC signing — REQUIRED to deliver async-mode webhooks
# (POST /run with `webhook_url` in the body). The runtime refuses to
# send webhooks if this is unset (no insecure default).
# Generate a long random string, e.g.:
#   openssl rand -hex 32
# and keep it secret. Downstream receivers verify the X-Skrun-Signature
# header against this key.
# With the Docker Compose stack, the quick start writes this name at the END
# of infra/.env: change that line (a name set twice: the last line wins).
# WEBHOOK_SIGNING_KEY=

# Allow webhook delivery to private / loopback hosts (e.g. http://localhost:NNNN).
# Fail-closed: OFF unless set to exactly "true". For LOCAL webhook testing only —
# never enable on a reachable deployment, it re-opens the SSRF surface toward
# cloud-metadata / internal services. Default: private / non-HTTPS targets refused.
SKRUN_ALLOW_LOCAL_WEBHOOKS=

# Allow an agent-declared `model.base_url` to point at a private / loopback
# address — the documented Ollama, vLLM and LocalAI case. Fail-closed: OFF
# unless set to exactly "true". Leave off on a shared instance: an endpoint
# chosen by an agent author is otherwise a request-forgery primitive against
# your internal network.
SKRUN_ALLOW_LOCAL_MODEL_HOSTS=

# Allow the SERVER's own LLM key to be sent to an endpoint an agent declares
# in `model.base_url`. Fail-closed: OFF unless set to exactly "true". Off by
# default because any agent author could otherwise redirect your key to a host
# they control. Enable only where every agent on this instance is yours —
# callers can always supply their own key instead (X-LLM-API-Key).
SKRUN_ALLOW_SERVER_KEY_CUSTOM_BASE_URL=

# CORS allowed origin(s) — REQUIRED when NODE_ENV=production. The API
# fails fast at startup if unset in prod.
# Comma-separated list, e.g.
#   https://app.example.com
#   https://app.example.com,https://staging.example.com
# Defaults to '*' in dev so local `pnpm dev:registry` + dashboard stay
# frictionless.
# With the Docker Compose stack, the quick start writes this name at the END
# of infra/.env: change that line (a name set twice: the last line wins).
# CORS_ORIGIN=

# ----- Storage / Database (optional — defaults to local SQLite) -----

# Postgres backing — when set, the registry uses PostgresDb instead of
# the default SQLite + local-FS storage. Leave unset for self-host
# single-user mode (skrun.db + .skrun/bundles/).
#
# DATABASE_URL is a standard `postgres://user:pass@host:port/db`
# connection string. Works with any Postgres ≥ 14 host:
#   - Supabase: use the SESSION POOLER on port 5432. "Connect" button
#     → "ORMs" or "Connection string" → "Session pooler" → URI.
#     Session mode preserves session state (advisory locks, prepared
#     statements) — required by our migrations-runner's pg_advisory_lock
#     concurrent-boot safety. Direct connection (db.<ref>.supabase.co)
#     is IPv6-only ($4/mo Supabase IPv4 add-on as safety net);
#     Transaction Pooler (6543) breaks advisory locks.
#   - Fly Postgres: copy from `flyctl postgres connect` output.
#   - RDS / Neon / Render / docker-compose: standard URI.
#
# Migrations apply automatically on api-server boot (server.ts +
# dev.ts Postgres branch) via the migrations-runner with
# `pg_advisory_lock` concurrent-safety.
#
# DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgres://skrun:<your-password>@localhost:5432/skrun
#
# ⚠️ POSTGRES_PASSWORD is MANDATORY for the full `infra/docker-compose.yml`
# stack — it builds the compose DATABASE_URL and Postgres's own superuser
# password from it. It used to fall back to `skrun-dev-only`, so an empty .env
# booted the database on a password published in this repository. The stack now
# refuses to start on an empty password rather than pick one for you.
#   openssl rand -hex 16
# The minimal self-host overlay (docker-compose.minimal.yml) runs on SQLite and
# does not need it.
# POSTGRES_PASSWORD=
#
# Postgres only — how long one statement may run before the database stops it,
# in milliseconds (1000 to 600000, default 10000). A connection that gets no
# answer at all is given up on 5 s after it (15 s by default). A request that
# meets either answers 503 DATABASE_TIMEOUT — a run's admission under a bound on
# runs in progress, compute time or fast runs, once it holds its connection:
# 503 CAPACITY_EXHAUSTED.
# Migrations run without it. Any other value refuses to start. See
# docs/self-hosting.md → Environment variables reference.
# SKRUN_DB_STATEMENT_TIMEOUT_MS=10000
#
# Keep a record of each account deletion and API key revocation in the bundle
# store (_deletions/), so that a database restored from a copy can have them
# done again. Off by default. Give the prefix a lifecycle rule as long as you
# keep database copies, plus two days. true or false; any other value refuses
# to start. See docs/self-hosting.md → Backups.
# SKRUN_DELETION_JOURNAL=false

# ----- OAuth (optional self-host, required for cloud / multi-user) -----

# GitHub OAuth app credentials — when BOTH are set, the registry runs
# in OAuth mode and rejects the `dev-token` shortcut. See docs/self-hosting.md.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Signup allowlist (optional, default = open signup). Restricts who may sign in
# via GitHub OAuth — for a private instance or a closed beta. Comma-separated;
# each entry is a username (case-insensitive) or id:<NNN> (the immutable GitHub
# id, survives a rename). When set, ONLY listed accounts may sign in (every
# login, web + `skrun login`); anyone else gets a "not authorized" page (no
# account created). Unset/empty = open. Include yourself — on an OAuth instance
# there is no dev-token escape, so a self-lockout is fixed only via this var.
# SKRUN_ALLOWED_GITHUB_USERS=alice,bob,id:90123

# Per-account quotas, by plan (optional). Each variable left unset is no bound
# at all — the default; an instance that sets none behaves as without quotas.
# A value the server cannot apply refuses to boot, naming the variable.
# Per-plan form: comma-separated plan=N entries, a bare number being the value
# of "free", the plan of every account that has none — "2", "free=2" and
# "2,pro=5" all give free 2. A plan is any name such a list uses (a-z, 0-9, -):
# to add one, add its key to each per-plan variable, no code; a plan a list
# does not name gets that list's free value. Each list needs a value for free.
# Whole numbers, at least 1 (fast runs: 0 allowed).
# Runs in flight per account — per plan:
# SKRUN_QUOTA_CONCURRENT_RUNS=free=2,pro=5
# Compute seconds per account and per window — per plan; needs the window:
# SKRUN_QUOTA_COMPUTE_SECONDS=free=3600,pro=14400
# The window, in seconds — one number for every plan; it must divide a day
# (86400) and is aligned on UTC (21600: renewals at 0, 6, 12 and 18 h UTC):
# SKRUN_QUOTA_WINDOW_S=21600
# Runs per rolling hour entitled to a pre-warmed machine — per plan, 0 allowed;
# applies only while the pool runs (SKRUN_RUNNER_POOL_SIZE above 0, cloud
# runtime), a run beyond it starting on a new machine, never refused:
# SKRUN_QUOTA_FAST_RUNS_PER_HOUR=free=20,pro=60
# Bundle storage per account, in MB (1 MB = 1048576 bytes) — per plan; a push
# past it is refused (413 STORAGE_QUOTA_EXCEEDED), before anything is stored:
# SKRUN_QUOTA_STORAGE_MB=free=500,pro=2048
# Live input-file uploads per account — per plan; the next upload is refused
# (429 INPUT_FILES_LIMIT_REACHED) until enough of them expire or are deleted.
# Counted by each server process, where the uploads live:
# SKRUN_QUOTA_INPUT_FILES=free=50,pro=200
# Runs in flight on the whole instance — one number for every plan:
# SKRUN_QUOTA_INSTANCE_CONCURRENT_RUNS=20
# The longest timeout a run may declare, in seconds — one number for every plan;
# a push of an agent that declares more is refused too:
# SKRUN_RUN_MAX_TIMEOUT_S=900

# CLI device-login (RFC 8628) code TTL in seconds (default 600). `skrun login`
# issues a short-lived device/user code pair the user confirms in the browser;
# a shorter TTL means a smaller window for device-code phishing. Optional.
# At most 3153600000 (100 years): a larger value is read as 100 years.
# SKRUN_DEVICE_CODE_TTL_S=600

# Lifetime, in days, of the API key `skrun login` mints (default 90). A key
# that never expires outlives the laptop it was copied onto; re-running
# `skrun login` costs one command. Set 0 to mint login keys with no expiry.
# Applies ONLY to the login flow: a key created via POST /api/keys expires
# only if the caller passes `expires_at` (no default is imposed on a key
# wired into someone else's integration). Never retroactive — keys that
# already exist keep no expiry. At most 36500 (100 years): a larger value is
# read as 36500, and 0 still means no expiry.
# SKRUN_API_KEY_TTL_DAYS=90

# Dev-token admin shortcut (fail-secure, default OFF). When SKRUN_DEV_AUTH is
# enabled (1/true/on/yes) AND OAuth is not configured, a `Bearer dev-token`
# request is treated as admin (namespace 'dev'). This grants admin to ANYONE
# who can reach the server — use it ONLY on localhost / a trusted private
# network, never a public host. `pnpm dev:registry` enables it automatically;
# the api-server REFUSES TO BOOT if it is enabled in production without OAuth.
# SKRUN_DEV_AUTH=1

# Verification policy (default 'admin'). Chooses who may attest an agent version
# and whether runs are gated on verification:
#   admin    (default) only instance admins verify; an unverified version can't
#            run (403 AGENT_NOT_VERIFIED) — the legacy behavior, so leaving this
#            unset changes nothing
#   owner    the agent owner may self-attest their own agents, and a private
#            agent runs without the gate (multi-tenant hosting — one operator
#            can't vet everyone's agents)
#   disabled no verification gate at all; the flag is inert metadata
# Read once at boot, so a change requires a restart. An invalid value fails the
# boot fast (the server refuses to start).
# SKRUN_VERIFICATION_POLICY=admin

# Secrets encryption key — REQUIRED only to attach a creator LLM key to an agent
# (the per-agent key your callers can run on without supplying their own). Skrun
# encrypts creator keys at rest with AES-256-GCM under this 32-byte master key;
# when unset, attaching a creator key is refused (runs still resolve caller /
# server keys normally). Generate one and keep it secret + backed up:
#   openssl rand -base64 32
# A malformed value fails the boot fast.
# ⚠️  Rotating this key WITHOUT re-encrypting the agent_llm_keys rows makes every
#     attached creator key undecryptable — agents relying on them then fail at run
#     time. Treat it like a database credential.
# SKRUN_SECRETS_ENCRYPTION_KEY=

# Lifetime of a dashboard sign-in session, in seconds. Default 604800 (7 days).
# Applies to the browser session cookie minted after the OAuth callback — API
# keys are unaffected. A non-numeric or non-positive value falls back to the
# default rather than failing the boot. At most 34560000 (400 days), the
# limit browsers put on a cookie's lifetime: a larger value is read as 400 days.
# SESSION_TTL_S=604800

# The canonical public origin of this deployment, e.g. https://api.example.com.
# A port is allowed; a path, a query or a fragment is not. Unset — the default —
# the server derives its own address from the X-Forwarded-Proto / Host headers
# of each request, which works behind a reverse proxy and is what every existing
# deployment does. Set it and it becomes the first source for every URL the
# server hands out: the GitHub OAuth redirect_uri, the CLI device-login
# verification URL, and the servers entry of the published schema — none of them
# then depend on a Host header the caller chose. A malformed value fails the
# boot rather than being guessed at. Required as soon as the next variable is set.
# SKRUN_PUBLIC_URL=https://api.example.com

# Registrable domain to scope the browser session cookie to, so a dashboard on
# one host and the API on another share a single sign-in. Unset — the default —
# the cookie stays host-only; in production it is named __Host-skrun_session,
# which no other host of your DNS zone can set (skrun_session outside
# production). When set, the value must be a registrable domain of which the
# canonical host above is the domain
# itself or a subdomain (api.example.com under example.com); a public suffix
# (co.uk, fly.dev), a value with no dot, or a bare IP host is a boot failure
# naming what was received and what was expected.
# ⚠️  Two costs to plan for, both one-off. In production the cookie is renamed to
#     __Secure-skrun_session, so every signed-in user signs in once more, once.
#     And a finished browser login lands on this domain itself — the scheme of
#     SKRUN_PUBLIC_URL, without the API's port — at the path SKRUN_LOGIN_RETURN_PATH
#     sets (below), its root by default, rather than on /dashboard. A
#     parent-domain cookie is also only as safe as its whole DNS zone: any host
#     under it can set a cookie this server will receive.
# SKRUN_SESSION_COOKIE_DOMAIN=example.com

# ----- Your own site in front of the API (optional) -----

# For an operator whose own website signs people in and publishes the terms,
# privacy policy and docs. Each of the five, left unset — the default — changes
# nothing; an empty value, or one made only of blanks, is a value not set. Read
# once at boot, so a change requires a restart. A value outside the form its
# setting takes fails the boot, naming the variable, the form it expects and the
# value it received (credentials masked). See docs/self-hosting.md, "Your own
# site in front of the API".

# The path a finished browser login returns to, on the site the cookie domain
# above names — the same address, with ?login=failed or ?login=denied, for a
# login that failed or was refused. Default /. Requires
# SKRUN_SESSION_COOKIE_DOMAIN: set without it, the boot fails. One leading /,
# already in the form a URL parser gives it, with no query or fragment: a value
# that parsing would change is refused (write /%C3%B6, not /ö).
# SKRUN_LOGIN_RETURN_PATH=/signin

# Your own sign-in page: GET /login then answers a temporary redirect to it,
# carrying nothing of the request, whether or not GitHub OAuth is configured
# here. Default: this server's own page. An absolute http:// or https:// address
# that a URL parser reads, with no blank, control character or credentials. A
# page of this server that sends a browser that is not signed in back to /login
# fails the boot — judged against SKRUN_PUBLIC_URL, so not checked without it.
# If one page of your site, on the cookie domain itself, does both — signs in
# and takes the visitor back — set both settings to it: this address, and its
# path above.
# SKRUN_LOGIN_PAGE_URL=https://example.com/signin

# Your terms and privacy policy. With either set, the CLI consent page (/device)
# and /login carry a line under their GitHub button — /login only when GitHub
# sign-in is configured — linking to each one set, and the dashboard's sidebar
# links to them. Default: none shown.
# SKRUN_TERMS_URL=https://example.com/legal/terms
# SKRUN_PRIVACY_URL=https://example.com/legal/privacy

# Your docs: the two "Read docs" links of the dashboard's home page lead there;
# every other link to the docs stays on this server's API reference. Default
# /docs, that reference.
# SKRUN_DOCS_URL=https://example.com/docs

# These three take an absolute address, as SKRUN_LOGIN_PAGE_URL does, or a path
# on this server's host (/terms, then an optional ?query and #fragment with no
# blank or control character) whose path part takes the form of
# SKRUN_LOGIN_RETURN_PATH. The API serves none of your pages: a path it does not
# serve itself answers 404, unless your reverse proxy routes it elsewhere.

# ----- Bundle / Runtime advisory limits (optional, defaults are sane) -----

# How long one call of the primary LLM may go unanswered, in ms, before an
# agent's declared fallback takes over. Default 45000. It applies only while no
# tool of the run has been called: once one has, the fallback never takes over,
# so no tool runs twice. A whole number from 1 to 2147483647 — any other value
# (0, negative, not a number) refuses to start. Raise it if you run very long
# single turns (large context / heavy reasoning) and see spurious failovers.
# No effect on agents without a declared fallback.
# SKRUN_PRIMARY_FAILOVER_MS=45000

# pino log level: debug | info | warn | error. Default info.
# LOG_LEVEL=info

# Cache of what runs read of a bundle, keyed by the bundle's content: how long
# an entry stays warm (seconds), how many entries are kept, and what they may
# weigh together (MB). Defaults 600 / 50 / 256. An entry holds the text of
# SKILL.md, agent.yaml and AGENTS.md — weighed one byte per character for a
# text all in ASCII, two otherwise —, and in local mode the bundle extracted to
# disk (flyio mode writes none). Past either bound the least recently used
# entries leave first; one heavier than the whole budget is served, not kept.
# Swept every 5 min: an extraction leaves the disk at most TTL + 5 min after it
# was made, or when the last local run using it ends. Each is read as the whole
# number it starts with (12.9 reads 12, 1e3 reads 1); a value that does not
# start with a positive whole number — empty, abc, 0, a negative — falls back
# to its default without a word. The server still starts.
# BUNDLE_CACHE_TTL=600
# BUNDLE_CACHE_MAX=50
# BUNDLE_CACHE_MAX_MB=256

# Script-deps cache root of this server (per-host), used when it runs agent
# scripts itself (SKRUN_RUNTIME=local). Default ~/.skrun/deps. Agents declaring a
# package.json / requirements.txt / pyproject.toml resolve their deps on first
# call and share a content-addressed cache entry per identical manifest. Unused
# on the cloud runtime: each sandbox installs its own run's dependencies.
# An empty value is not unset — it is taken as the directory. Leave the line
# commented unless you give it a path.
# SKRUN_DEPS_DIR=

# Dashboard agent import — points at the demo agents directory.
# Path is resolved relative to the registry's working directory.
# `pnpm dev:registry` runs from `packages/api/` so the path climbs two
# levels back to the repo root. Use `./agents` if you start the
# registry from the repo root directly.
# Bare-metal install only: the Docker Compose stack fixes it empty (no agents
# directory to import from), whatever infra/.env says.
SKRUN_AGENTS_DIR=../../agents

# ----- Operator dashboard (optional) -----

# The bare-metal install and the published image both serve the operator
# dashboard at /dashboard by default. Set to off/false/0 for a headless,
# API-only server.
SKRUN_DASHBOARD=on

# Path to the built dashboard SPA. Defaults to ../web/dist (bare-metal, cwd =
# packages/api) or /opt/skrun-web/dist in the published image. Override only to
# serve a custom dashboard build.
# An empty value is not unset — it is taken as the directory. Leave the line
# commented unless you give it a path.
# SKRUN_DASHBOARD_DIR=

# Multimodal inputs — uploaded input files via POST /api/files
# INPUT_FILES_MAX_SIZE_MB=25         # Max upload size per file (default 25 MB)
# INPUT_FILES_RETENTION_S=86400      # How long uploaded inputs are kept (default 24 h; swept every 5 min; at most 100 years — a larger value is read as 100 years)
# FILES_RETENTION_S=3600             # How long agent output files are kept (default 1 h; swept every 5 min — in flyio mode, also the files runs leave in object storage; at most 100 years — a larger value is read as 100 years)
# Inline files on POST /run (source: data) have a fixed cap, set by no
# variable: 4 MB per file, and together what the run's body cap (about
# 6.33 MB) leaves them — about 4.7 MB when the rest of the request is small.

# Bundle decompression cap in MB (default 50) — what an .agent bundle may
# decompress to, its tar headers counted (gzip-bomb defense). A push past it is
# refused with 413 BUNDLE_DECOMPRESSED_TOO_LARGE, before anything is stored; a
# run of a version stored past it, with 422 BUNDLE_DECOMPRESSED_TOO_LARGE.
# Raise it together with SKRUN_PUSH_MAX_BODY_MB below, and only if your
# legitimate agents exceed it. Read as SKRUN_PUSH_MAX_BODY_MB is: a positive
# decimal number of MB (50, 0.5 — a fraction is counted in whole bytes) — the
# server refuses to boot on anything else, an empty value, 0, 1e3, 0x10 or a
# value under one byte included. skrun pull reads the same variable from its
# user's environment, the same way: on such a value it stops before
# downloading anything.
# BUNDLE_MAX_DECOMPRESSED_MB=50

# Push request-body cap in MB (default 50). Bounds the COMPRESSED body of
# POST /api/agents/:ns/:name/push; the server never reads more of it, and
# reads nothing before the caller is authenticated — over it the push is
# refused with 413 BUNDLE_TOO_LARGE. This is a different ceiling from
# BUNDLE_MAX_DECOMPRESSED_MB above, which bounds what the archive expands to;
# both apply — raise the two together: a bundle skrun build makes unpacks to
# about its compressed size or more (only an archive padded in its gzip header
# unpacks to much less). Behind the Docker Compose stack, Caddy's max_size
# (infra/Caddyfile.example, 50MiB) bounds the same body first: raise it too. Must be a positive decimal number of MB (50,
# 0.5) — the server refuses to boot on anything else, an empty value, 1e3,
# 0x10 or a value under one byte included.
# SKRUN_PUSH_MAX_BODY_MB=50

# Default request-body cap in MB (default 1), for every route without a cap
# of its own — over it, 413 REQUEST_TOO_LARGE. The push (above), POST
# /api/files (INPUT_FILES_MAX_SIZE_MB + 1 MB of framing) and POST /run
# (about 6.33 MB, fixed) have their own. Must be a positive decimal number
# of MB (1, 0.5) — the server refuses to boot on anything else, an empty
# value, 1e3, 0x10 or a value under one byte included.
# SKRUN_MAX_BODY_MB=1

# MCP server connect timeout (ms). Each MCP server's connect() call (stdio
# spawn / SSE handshake / streamable-HTTP handshake) is bounded by this
# timeout, plumbed to the MCP SDK via client.connect(transport, { timeout }).
# On expiry the runtime logs `event=mcp_connect_timeout`, tears down the
# half-open transport, and the agent run FAILS with 502 MCP_CONNECT_FAILED.
# Default 120000 (2 min) accommodates stdio cold-starts via `npx -y @some/mcp`
# (@playwright/mcp measured at ~70s on warm chromium cache). Bump to 180000+
# if your runner downloads chromium / large MCP binaries from cold.
# MCP_CONNECT_TIMEOUT_MS=120000

# ============================================================================
# Cloud runtime (Fly.io machines + R2 storage)
# ============================================================================
# Set SKRUN_RUNTIME=flyio to run each `POST /run` inside a dedicated Fly.io
# machine spawned from the multi-runtime image. The harness (this API
# server) holds all credentials; the sandbox machine has zero credentials
# (network egress restricted via iptables to environment.networking.allowed_hosts).
# Default `local` keeps every run in-process — what self-host operators want.
# The Docker Compose stack fixes it to `local`, whatever infra/.env says.
# SKRUN_RUNTIME=local

# --- Fly.io Machines API (REQUIRED when SKRUN_RUNTIME=flyio) ---
# Generate a deploy token on the target app:
#   fly tokens create deploy -a <your-skrun-app>
# The token grants machine create/start/stop/destroy + reading machine
# metadata. Scope it to the dedicated app, not your personal account.
# FLY_API_TOKEN=
# SKRUN_RUNNERS_APP=
# NOTE — variable was renamed from FLY_APP_NAME on 2026-05-25. Fly auto-
# injects FLY_APP_NAME into every running machine's env as the current
# app's name, which silently overrode user-supplied secrets when the
# api-server tried to use that variable to identify the SANDBOX runners
# app (a different app). SKRUN_RUNNERS_APP is skrun-namespaced and
# collision-free.

# FLY_APP_NAME — legacy fallback, kept only for setups predating the rename.
# `skrun admin cleanup-machines` resolves its app as --app > SKRUN_RUNNERS_APP >
# FLY_APP_NAME, so you normally set nothing here. ⚠️ Inside a Fly machine Fly sets
# FLY_APP_NAME to that machine's OWN app, so a reaper falling back to it sweeps
# the wrong app and reports `scanned=0 cleaned=0`; the command warns when it does
# and names the swept app in its PASS line. See docs/cli.md → skrun admin.
# FLY_APP_NAME=

# Optional: only needed for the on-demand Fly smoke (`pnpm fly:smoke`).
# Distinct from SKRUN_RUNNERS_APP so the smoke doesn't accidentally hit the
# production sandbox app. Typically set to the same value as SKRUN_RUNNERS_APP
# in solo dev.
# FLY_TEST_APP_NAME=

# Image for the on-demand Fly smoke (`pnpm fly:smoke`) + the cold-start
# benchmark. Defaults to the always-resolvable `:edge` tag (published on every
# image build, never pruned), so you normally don't set this. Override only to
# pin a specific build, e.g. :vX.Y.Z after a stable release.
# FLY_TEST_IMAGE=ghcr.io/skrun-dev/skrun-runtime:edge

# Deployed cloud api-server URL + auth token for the on-demand cloud-E2E smoke
# (`pnpm cloud:e2e:smoke`). Point at the deployed test app. The token must be an
# API key (`skrun_sk_…`): cloud / OAuth deployments reject the dev-token
# shortcut. Mint one in the dashboard's Settings, with the expiry you choose; a
# key from `skrun login` (saved to ~/.skrun/config.json) also works, until the
# server's login-key lifetime ends (90 days by default). A bare
# dev-token only works against a deployment that has OAuth disabled.
# SKRUN_CLOUD_API_URL=https://skrun-cloud-api-test.fly.dev
# SKRUN_CLOUD_API_TOKEN=skrun_sk_...

# Runner image the api-server spawns per run (pushed to GHCR by
# .github/workflows/runtime-image.yml). REQUIRED when SKRUN_RUNTIME=flyio — the
# server fails fast at startup if unset (no silent fallback). Tag policy:
#   :edge        latest build, always resolvable (dev / pre-release)
#   :latest      latest stable release
#   :vX.Y.Z      pinned stable (reproducible — recommended for production)
# ⚠️ Here the value is a FULL image reference. `infra/docker-compose.yml` reads a
# variable of the SAME NAME as the tag alone (it interpolates it after the colon),
# so uncommenting the line below in infra/.env makes its image reference
# malformed and `docker compose up` fails. In that stack the variable only picks
# the image tag: the stack fixes SKRUN_RUNTIME=local and hands its api service an
# empty RUNTIME_IMAGE_TAG, so the server never reads it.
# RUNTIME_IMAGE_TAG=ghcr.io/skrun-dev/skrun-runtime:edge

# Pre-warm pool: how many sandbox machines to keep built and paused so a run does
# not wait for one to be created. Default 0 = off, every run builds its own
# machine (unchanged behaviour); the server's machine maintenance runs at any
# size (docs/self-hosting.md → Machine maintenance). A pooled machine is blank
# until a run claims it, serves exactly one run, and is destroyed afterwards like
# any other. When the pool is empty a run simply takes the slower path — never an
# error. Watch it via GET /api/admin/pool. See docs/self-hosting.md → Pre-warm pool.
# SKRUN_RUNNER_POOL_SIZE=0

# --- Rate limiting (optional) ---
# The api-server rate-limits `push` (10/min) and `run` (60/min) per client IP.
# Single-instance self-host uses an in-memory limiter — nothing to set. For a
# MULTI-INSTANCE deployment, point it at Upstash Redis so the limit is shared
# across instances (otherwise it is counted per-process and can be bypassed):
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# Set when the api-server is behind a reverse proxy / load balancer, so the
# client IP is taken from X-Forwarded-For. Leave unset on a directly-exposed
# deployment — the header is then ignored (it would otherwise be spoofable).
# The shipped docker-compose.yml already sets it on the api service (the api
# is only reachable through Caddy there, and the shipped Caddyfile overwrites
# the header) — this line matters for hand-rolled deployments behind a proxy.
# Your proxy MUST overwrite X-Forwarded-For (not append) or the key is forged.
# SKRUN_TRUST_PROXY=1
# If your gateway APPENDS to X-Forwarded-For instead of overwriting it, the
# first hop of that header is whatever the caller sent, so keying the limit on
# it lets one caller mint a fresh counter per request. Such a gateway normally
# writes the address into a header of its own — name that header here and it
# becomes the key (case-insensitive; read only when SKRUN_TRUST_PROXY is on).
# Set but missing from a request = that request did not come through the named
# gateway: the limiter falls back to the socket address (degraded, one counter
# for everything on that path), never to X-Forwarded-For.
# The Docker Compose stack fixes it empty, whatever infra/.env says: its Caddy
# overwrites X-Forwarded-For, while a header it does not overwrite would let
# each caller choose its own key.
# SKRUN_TRUST_PROXY_HEADER=x-edge-client-ip

# --- S3-compatible object storage (REQUIRED when SKRUN_RUNTIME=flyio) ---
# Cloudflare R2 OR MinIO (self-host). Same code path; `S3_ENDPOINT` toggles:
#   - cloud (R2):      set S3_ACCOUNT_ID (or leave S3_ENDPOINT unset)
#   - self-host MinIO: set S3_ENDPOINT to your MinIO URL
# Bundle archives + run outputs live in S3_BUCKET — run outputs under `_runs/{runId}/outputs/`.
# Presigned GET URLs are emitted in `run_complete` events.
#
# ⚠️ MANDATORY for the full `infra/docker-compose.yml` stack. They used to have
# `:-minioadmin` fallbacks, so `docker compose up` with an empty .env booted
# MinIO on credentials anyone can guess. The stack now REFUSES to start rather
# than pick a default for you. MinIO would otherwise boot on minioadmin, so a
# preflight container stops the whole stack when either is empty.
#   openssl rand -hex 16
# The minimal self-host overlay (docker-compose.minimal.yml) runs on local disk
# and needs neither.
# S3_ACCOUNT_ID=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
