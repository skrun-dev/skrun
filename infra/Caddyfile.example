# Caddyfile.example — Skrun self-host reverse proxy.
#
# Caddy handles TLS termination (via Let's Encrypt) and reverse-proxies
# the API container. The `flush_interval -1` directive is REQUIRED for
# Server-Sent Events: it disables Caddy's response buffering so each
# event written by the Hono SSE handler flushes through to the client
# immediately. Without it, SSE consumers see events arrive in batch
# every ~8KB or 5s — breaking the run_heartbeat / live token streaming
# UX.
#
# Replace `{$DOMAIN}` via the env var:
#   DOMAIN=skrun.example.com docker compose up -d
# For local dev / no TLS:
#   DOMAIN=:80 docker compose up -d
#
# See https://caddyserver.com/docs/caddyfile/directives/reverse_proxy
# for the full directive reference.

{$DOMAIN} {
	# Reverse proxy to the API container.
	reverse_proxy api:4000 {
		# REQUIRED for SSE (POST /run with Accept: text/event-stream).
		# Disables response buffering — each yielded event flushes through.
		flush_interval -1

		# OVERWRITE X-Forwarded-For with the address Caddy itself saw.
		# The api reads the FIRST hop of this header when SKRUN_TRUST_PROXY
		# is set (rate-limit keying); reverse_proxy's default APPENDS the
		# client address to an incoming header instead of replacing it, so
		# without this line the first hop would be whatever the caller
		# forged — one client could masquerade as many.
		header_up X-Forwarded-For {remote_host}
	}

	# Sensible defaults for self-host: request bodies up to 50 MiB, the API's
	# 50 MB. Caddy sees each body as it is sent: a push's is the COMPRESSED
	# bundle, which the API bounds at SKRUN_PUSH_MAX_BODY_MB (default 50); an
	# upload's is the file plus its multipart framing, bounded at
	# INPUT_FILES_MAX_SIZE_MB plus 1 MB. If you raise either, raise this with
	# it, in MiB: the API counts a MB as 1,048,576 bytes, as Caddy counts a
	# MiB, while Caddy's MB is 1,000,000 — 50MB here would refuse a push the
	# API's default cap accepts. BUNDLE_MAX_DECOMPRESSED_MB bounds what the API
	# unpacks a bundle to: Caddy never sees that size.
	request_body {
		max_size 50MiB
	}

	# Structured access log to stdout. Caddy auto-formats as JSON;
	# `docker logs caddy` shows the requests.
	log {
		output stdout
		format json
	}
}
