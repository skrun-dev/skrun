{
  "name": "skrun-api-server",
  "version": "0.0.0",
  "private": true,
  "description": "Install manifest of the API in the api-server target of the skrun-runtime image. Lists the production dependencies of @skrun-dev/schema, @skrun-dev/runtime and @skrun-dev/api, each pinned to the version pnpm-lock.yaml resolved; the image installs package-lock.json with npm ci --omit=dev, then extracts the three tarballs into node_modules at build time. Regenerate the lock with infra/runtime-image/update-locks.sh.",
  "dependencies": {
    "@anthropic-ai/sdk": "0.92.0",
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/s3-request-presigner": "3.1053.0",
    "@google/generative-ai": "0.24.1",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.9.0",
    "hono": "4.13.16",
    "openai": "6.35.0",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "tar-stream": "3.2.0",
    "tldts": "7.4.16",
    "undici": "8.12.3",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server@<2.1.6": "^2.1.6",
    "body-parser@<2.4.0": "^2.4.0",
    "fast-uri": "^3.1.9",
    "fast-xml-parser": "^5.12.0",
    "hono@<4.13.16": "^4.13.16",
    "ip-address": "^10.7.4",
    "nanoid@>=5.0.0 <6.0.0": "^5.1.16",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "source-map-js": "^1.2.2",
    "undici@<7.30.1": "^7.30.1",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
