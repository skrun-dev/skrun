{
  "name": "skrun",
  "private": true,
  "type": "module",
  "description": "Deploy any Agent Skill as an API — The Vercel for Agent Skills",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "llm",
    "api",
    "runtime",
    "agent-as-api",
    "typescript",
    "hono",
    "multi-model",
    "stateful-agents"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "pnpm -r run dev",
    "dev:web": "pnpm --filter @skrun-dev/web dev",
    "build:web": "pnpm --filter @skrun-dev/web build",
    "dev:registry": "pnpm --filter @skrun-dev/api dev",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:live": "node --use-system-ca --import tsx tests/e2e.ts",
    "bench:cold-start": "node --use-system-ca --env-file=.env --import tsx scripts/run-cold-start-bench.ts",
    "cloud:e2e:smoke": "node --use-system-ca --env-file=.env --import tsx scripts/run-flyio-cloud-e2e.ts",
    "fly:smoke": "node --use-system-ca --env-file=.env --import tsx scripts/run-fly-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.59.1",
    "semver": "7.7.4",
    "tsx": "^4.23.13",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static"
    ],
    "overrides": {
      "@hono/node-server@<2.1.6": "^2.1.6",
      "body-parser@<2.4.0": "^2.4.0",
      "fast-uri": "^3.1.9",
      "fast-xml-parser": "^5.12.0",
      "hono@<4.13.16": "^4.13.16",
      "ip-address": "^10.7.4",
      "nanoid@>=5.0.0 <6.0.0": "^5.1.16",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "source-map-js": "^1.2.2",
      "undici@<7.30.1": "^7.30.1",
      "ws": "^8.20.1"
    }
  }
}
