{
  "name": "skrun",
  "private": true,
  "type": "module",
  "description": "Deploy any Agent Skill as an API — The Vercel for Agent Skills",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "llm",
    "api",
    "runtime",
    "agent-as-api",
    "typescript",
    "hono",
    "multi-model",
    "stateful-agents"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "pnpm -r run dev",
    "dev:web": "pnpm --filter @skrun-dev/web dev",
    "build:web": "pnpm --filter @skrun-dev/web build",
    "dev:registry": "pnpm --filter @skrun-dev/api dev",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:live": "node --use-system-ca --env-file=.env --import tsx tests/e2e.ts",
    "bench:cold-start": "node --use-system-ca --env-file=.env --import tsx scripts/run-cold-start-bench.ts",
    "cloud:e2e:smoke": "node --use-system-ca --env-file=.env --import tsx scripts/run-flyio-cloud-e2e.ts",
    "fly:smoke": "node --use-system-ca --env-file=.env --import tsx scripts/run-fly-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static"
    ],
    "overrides": {
      "@hono/node-server@<1.19.15": "^1.19.17",
      "body-parser@<2.3.0": "^2.3.0",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "nanoid@>=5.0.0 <6.0.0": "^5.1.16",
      "qs": "^6.15.2",
      "ws": "^8.20.1"
    }
  }
}
