{
  "name": "@skrun-dev/api",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --use-system-ca --env-file=../../.env --import tsx src/dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@hono/node-server": "^2.1.1",
    "@scalar/hono-api-reference": "^0.10.13",
    "@skrun-dev/runtime": "workspace:*",
    "@skrun-dev/schema": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.13.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/tar-stream": "3.1.4",
    "tar-stream": "3.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrun-dev/skrun.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/skrun-dev/skrun#readme",
  "bugs": "https://github.com/skrun-dev/skrun/issues",
  "keywords": [
    "skrun",
    "agent-skills",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
